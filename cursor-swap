#!/usr/bin/env bash
# cursor-swap: multi-account switcher for cursor-agent CLI
#
# Two account types:
#   session  - a real browser login (email/password/SSO). Swapping overwrites the
#              CLI's Keychain items (cursor-access-token / cursor-refresh-token,
#              account cursor-user) + cached authInfo in ~/.cursor/cli-config.json.
#              This is GLOBAL state: only one session account can be "active" at a
#              time on this machine, and swapping mid-session in one terminal
#              affects `agent` in every other terminal too.
#   api-key  - a Cursor API key (agent --api-key / $CURSOR_API_KEY). Never touches
#              global state - passed per-invocation, so `run` with an api-key
#              profile is safe to use concurrently in multiple terminals.
#
# IDE account (ide-add/ide-switch): Cursor.app (the desktop editor) is a SEPARATE
# login from the CLI - can be on a different account entirely. Its session lives as
# plaintext cursorAuth/accessToken + cursorAuth/refreshToken rows in the app's own
# sqlite db (User/globalStorage/state.vscdb, ItemTable), found by reading that file
# after quitting the app (WAL wasn't checkpointed while it ran) - not the "Cursor
# Safe Storage" Keychain item, which is Electron's own encryption key for unrelated
# things. UNDOCUMENTED on-disk format - can change on a Cursor update. Swapping
# requires the app fully quit first (live process can overwrite the write, and it
# only reads auth off disk at startup) - ide-switch quits it for you (with confirm)
# and relaunches after.
#
# Usage %: `agent status`/`agent about` expose none, but the CLI's own JS bundle
# calls an undocumented backend RPC (aiserver.v1.DashboardService/GetCurrentPeriodUsage)
# with the same Bearer access-token cursor-swap already stores per profile. list/switch/
# usage call it best-effort. UNDOCUMENTED - not a public API, no stability guarantee,
# can silently break on a Cursor update.
#
# NOT implemented, on purpose (not just missing):
#   auto              - auto-switch by remaining quota. The usage % above comes from an
#                        undocumented endpoint; building an automated strategy on top of
#                        something that can break silently is a step too far. Use
#                        `cursor-swap usage` yourself and switch manually.
#   tui/watch/menubar - same reason: not worth building a dashboard on unstable data.
#   swap/move (slot renumbering) - slots are just stable ids assigned at
#                      creation; reassigning them adds complexity for no real
#                      benefit here. Use aliases instead.

set -euo pipefail

VERSION="1.5.1"
STORE="$HOME/.cursor-accounts"
MAPFILE="$STORE/mappings.json"
CONFIG="$HOME/.cursor/cli-config.json"
RAW_BASE="https://raw.githubusercontent.com/CuKhoi/cursor-switch/main"
API_BASE="https://api2.cursor.sh"
SVC_ACCESS="cursor-access-token"
SVC_REFRESH="cursor-refresh-token"
KC_ACCOUNT="cursor-user"
IDE_DB="$HOME/Library/Application Support/Cursor/User/globalStorage/state.vscdb"

die() { echo "error: $*" >&2; exit 1; }
need_jq() { command -v jq >/dev/null || die "jq required"; }

confirm() {
    [[ "${YES:-0}" == "1" ]] && return 0
    read -r -p "$1 [y/N] " ans
    [[ "$ans" =~ ^[Yy]$ ]]
}

current_email() {
    [[ -f "$CONFIG" ]] && jq -r '.authInfo.email // "unknown"' "$CONFIG" 2>/dev/null || echo "unknown"
}

current_ide_email() {
    [[ -f "$IDE_DB" ]] || return
    local email; email=$(sqlite3 "$IDE_DB" "SELECT value FROM ItemTable WHERE key='cursorAuth/cachedEmail';" 2>/dev/null)
    if [[ -z "$email" ]]; then
        # cachedEmail can lag behind a fresh login for a bit - fall back to
        # matching the token's auth0 sub against a saved CLI profile's authId.
        local sub token
        token=$(sqlite3 "$IDE_DB" "SELECT value FROM ItemTable WHERE key='cursorAuth/accessToken';" 2>/dev/null)
        sub=$(_jwt_sub "$token")
        if [[ -n "$sub" ]]; then
            for cfg in "$STORE"/*/cli-config.json; do
                [[ -f "$cfg" ]] || continue
                if [[ "$(jq -r '.authInfo.authId // empty' "$cfg" 2>/dev/null)" == "$sub" ]]; then
                    email=$(jq -r '.authInfo.email' "$cfg")
                    break
                fi
            done
        fi
    fi
    echo "$email"
}

ensure_store() { mkdir -p "$STORE"; chmod 700 "$STORE"; [[ -f "$MAPFILE" ]] || echo '{}' > "$MAPFILE"; }

next_slot() {
    local max=0 s
    for m in "$STORE"/*/meta.json; do
        [[ -f "$m" ]] || continue
        s=$(jq -r '.slot // 0' "$m")
        (( s > max )) && max=$s
    done
    echo $((max + 1))
}

# echoes the profile dir for a slot number / name / alias / email, or nothing
resolve_profile() {
    local ref="$1" dir name
    for dir in "$STORE"/*/; do
        [[ -f "$dir/meta.json" ]] || continue
        name=$(basename "$dir")
        if [[ "$name" == "$ref" ]]; then echo "${dir%/}"; return; fi
        if [[ "$(jq -r '.slot' "$dir/meta.json")" == "$ref" ]]; then echo "${dir%/}"; return; fi
        if [[ "$(jq -r '.alias // empty' "$dir/meta.json")" == "$ref" ]]; then echo "${dir%/}"; return; fi
        if [[ "$(jq -r '.email' "$dir/meta.json")" == "$ref" ]]; then echo "${dir%/}"; return; fi
    done
}

require_profile() {
    local ref="$1" dir
    dir=$(resolve_profile "$ref")
    [[ -n "$dir" ]] || die "no account matches '$ref' (see: cursor-swap list)"
    echo "$dir"
}

label() {
    local dir="$1" name alias
    name=$(basename "$dir")
    alias=$(jq -r '.alias // empty' "$dir/meta.json")
    [[ -n "$alias" ]] && echo "$name ($alias)" || echo "$name"
}

# any access token this profile has, CLI's or the IDE's - the usage-% API
# doesn't care which surface a token came from, it's the same backend.
_any_access_token() {
    local dir="$1"
    if [[ -f "$dir/access-token" ]]; then
        cat "$dir/access-token" 2>/dev/null
    elif [[ -f "$dir/ide-auth.json" ]]; then
        jq -r '.[] | select(.key=="cursorAuth/accessToken") | .value' "$dir/ide-auth.json" 2>/dev/null
    fi
}

# best-effort: prints "  total: N%  auto: N%  api: N%" for a given access token,
# or nothing + non-zero exit on any failure (expired token, network, API shape changed).
usage_summary() {
    local token="$1" resp
    [[ -n "$token" ]] || return 1
    resp=$(curl -sS --max-time 4 -X POST "$API_BASE/aiserver.v1.DashboardService/GetCurrentPeriodUsage" \
        -H "Authorization: Bearer $token" -H "Content-Type: application/json" \
        -H "Connect-Protocol-Version: 1" -d '{}' 2>/dev/null) || return 1
    jq -e '.planUsage.totalPercentUsed' <<<"$resp" >/dev/null 2>&1 || return 1
    jq -r 'def r1: (.*10|round)/10;
        .planUsage | "total: \((.totalPercentUsed // 0)|r1)%  auto: \((.autoPercentUsed // 0)|r1)%  api: \((.apiPercentUsed // 0)|r1)%"' <<<"$resp"
}

# ---- capture a live session account into a profile dir ----
capture_session() {
    local name="$1" access refresh email dir alias="${2:-}"
    access=$(security find-generic-password -s "$SVC_ACCESS" -a "$KC_ACCOUNT" -w 2>/dev/null) || die "no active session (cursor-access-token not in Keychain). Run 'agent login' first."
    refresh=$(security find-generic-password -s "$SVC_REFRESH" -a "$KC_ACCOUNT" -w 2>/dev/null) || die "no active session (cursor-refresh-token not in Keychain)."
    [[ -f "$CONFIG" ]] || die "$CONFIG not found"
    email=$(current_email)

    dir="$STORE/$name"
    local slot
    if [[ -d "$dir" ]]; then
        confirm "Profile '$name' exists ($(jq -r '.email' "$dir/meta.json" 2>/dev/null || echo '?')). Overwrite?" || { echo "aborted"; exit 1; }
        slot=$(jq -r '.slot' "$dir/meta.json")
        [[ -z "$alias" ]] && alias=$(jq -r '.alias // empty' "$dir/meta.json")
    else
        slot=$(next_slot)
    fi
    mkdir -p "$dir"; chmod 700 "$dir"
    printf '%s' "$access"  > "$dir/access-token";  chmod 600 "$dir/access-token"
    printf '%s' "$refresh" > "$dir/refresh-token"; chmod 600 "$dir/refresh-token"
    cp "$CONFIG" "$dir/cli-config.json"
    jq -n --arg email "$email" --arg ts "$(date -u +%FT%TZ)" --argjson slot "$slot" \
        --arg alias "$alias" --arg type "session" \
        '{email:$email, saved_at:$ts, slot:$slot, alias:(if $alias=="" then null else $alias end), type:$type, enabled:true}' \
        > "$dir/meta.json"
    echo "Saved '$name' ($email) as slot $slot"
}

_has_cli_session() {
    security find-generic-password -s "$SVC_ACCESS" -a "$KC_ACCOUNT" -w >/dev/null 2>&1
}

_has_ide_session() {
    [[ -f "$IDE_DB" ]] || return 1
    local v; v=$(sqlite3 "$IDE_DB" "SELECT value FROM ItemTable WHERE key='cursorAuth/accessToken';" 2>/dev/null)
    [[ -n "$v" ]]
}

# captures whichever of CLI / Cursor.app IDE is currently logged in - either,
# both, or (if neither) errors. Most people only use one or the other, so
# this doesn't require both like the old always-capture-CLI version did.
cmd_add() {
    local name="" alias=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --alias) alias="$2"; shift 2 ;;
            *) name="$1"; shift ;;
        esac
    done
    [[ -n "$name" ]] || die "usage: cursor-swap add <name> [--alias X]"
    ensure_store

    local got_cli=0 got_ide=0
    if _has_cli_session; then
        capture_session "$name" "$alias"
        got_cli=1
    else
        echo "note: no active CLI session (agent not logged in) - skipping CLI capture"
    fi
    if _has_ide_session; then
        local ide_args=("$name")
        [[ -n "$alias" ]] && ide_args+=(--alias "$alias")
        cmd_ide_add "${ide_args[@]}"
        got_ide=1
    else
        echo "note: no active Cursor.app IDE session - skipping IDE capture"
    fi
    (( got_cli || got_ide )) || die "not logged in anywhere - run 'agent login' or log into the Cursor.app IDE first"
}

cmd_login() {
    local name="${1:?usage: cursor-swap login <name>}"
    ensure_store
    echo "Logging out current session..."
    agent logout >/dev/null 2>&1 || true
    echo "Opening browser login for new account..."
    agent login
    capture_session "$name"
}

cmd_add_token() {
    need_jq; ensure_store
    local token="${1:?usage: cursor-swap add-token <key|-> [--email E] [--alias A]}"; shift || true
    local email="" alias=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --email) email="$2"; shift 2 ;;
            --alias) alias="$2"; shift 2 ;;
            *) shift ;;
        esac
    done
    [[ "$token" == "-" ]] && token=$(cat)
    local slot; slot=$(next_slot)
    [[ -n "$email" ]] || email="api-key-${slot}@token.local"
    local dir="$STORE/$email"
    mkdir -p "$dir"; chmod 700 "$dir"
    printf '%s' "$token" > "$dir/api-key"; chmod 600 "$dir/api-key"
    jq -n --arg email "$email" --arg ts "$(date -u +%FT%TZ)" --argjson slot "$slot" \
        --arg alias "$alias" --arg type "api-key" \
        '{email:$email, saved_at:$ts, slot:$slot, alias:(if $alias=="" then null else $alias end), type:$type, enabled:true}' \
        > "$dir/meta.json"
    echo "Registered API-key profile '$email' as slot $slot"
}

_ide_running() { pgrep -x Cursor >/dev/null 2>&1; }

# decodes the auth0 subject ("sub") claim out of a Cursor JWT's payload, no
# verification (we already trust it - it's our own stored token).
_jwt_sub() {
    local payload; payload=$(cut -d. -f2 <<<"$1" | tr -- '-_' '+/')
    case $(( ${#payload} % 4 )) in
        2) payload="${payload}==" ;;
        3) payload="${payload}=" ;;
    esac
    base64 -d <<<"$payload" 2>/dev/null | jq -r '.sub // empty' 2>/dev/null
}

# jq program that turns [{key,value},...] rows into REPLACE-on-conflict INSERT
# statements (ItemTable.key is UNIQUE ON CONFLICT REPLACE, so a plain INSERT
# acts as an upsert). Built via a quoted heredoc so the SQL quote-escaping
# (' -> '') needs no bash-level escaping of its own.
IFS= read -r -d '' _IDE_ROWS_TO_SQL <<'JQEOF' || true
def esc: gsub("'"; "''");
.[] | "INSERT INTO ItemTable(key,value) VALUES('" + (.key|esc) + "', '" + ((.value|tostring)|esc) + "');"
JQEOF

cmd_ide_add() {
    need_jq; ensure_store
    local name="" alias=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --alias) alias="$2"; shift 2 ;;
            *) name="$1"; shift ;;
        esac
    done
    [[ -n "$name" ]] || die "usage: cursor-swap ide-add <name> [--alias X]"
    [[ -f "$IDE_DB" ]] || die "$IDE_DB not found - is Cursor.app installed?"

    local rows; rows=$(sqlite3 -json "$IDE_DB" "SELECT key, value FROM ItemTable WHERE key LIKE 'cursorAuth/%';" 2>/dev/null)
    [[ -n "$rows" && "$rows" != "[]" ]] || die "no cursorAuth/* rows in Cursor.app's local db - log into the IDE first"
    local ide_email; ide_email=$(jq -r '.[] | select(.key=="cursorAuth/cachedEmail") | .value' <<<"$rows")
    if [[ -z "$ide_email" ]]; then
        # right after a fresh IDE login, cachedEmail can lag behind the tokens
        # for a bit - fall back to matching the token's auth0 sub against a
        # saved CLI profile's own cached authId.
        local access_token sub
        access_token=$(jq -r '.[] | select(.key=="cursorAuth/accessToken") | .value' <<<"$rows")
        sub=$(_jwt_sub "$access_token")
        if [[ -n "$sub" ]]; then
            for cfg in "$STORE"/*/cli-config.json; do
                [[ -f "$cfg" ]] || continue
                if [[ "$(jq -r '.authInfo.authId // empty' "$cfg")" == "$sub" ]]; then
                    ide_email=$(jq -r '.authInfo.email' "$cfg")
                    break
                fi
            done
        fi
    fi
    [[ -n "$ide_email" ]] || die "couldn't find a cached email for the current IDE session (cachedEmail not populated yet - wait a few seconds in the IDE and retry)"

    local dir="$STORE/$name" slot
    if [[ -d "$dir" ]]; then
        slot=$(jq -r '.slot' "$dir/meta.json")
        [[ -z "$alias" ]] && alias=$(jq -r '.alias // empty' "$dir/meta.json")
    else
        slot=$(next_slot)
    fi
    mkdir -p "$dir"; chmod 700 "$dir"
    echo "$rows" > "$dir/ide-auth.json"; chmod 600 "$dir/ide-auth.json"

    if [[ -f "$dir/meta.json" ]]; then
        jq --arg e "$ide_email" '.ide_email = $e' "$dir/meta.json" > "$dir/meta.json.tmp" && mv "$dir/meta.json.tmp" "$dir/meta.json"
    else
        jq -n --arg email "$ide_email" --arg ts "$(date -u +%FT%TZ)" --argjson slot "$slot" \
            --arg alias "$alias" \
            '{email:$email, ide_email:$email, saved_at:$ts, slot:$slot, alias:(if $alias=="" then null else $alias end), type:"ide-only", enabled:true}' \
            > "$dir/meta.json"
    fi
    echo "Saved IDE session '$name' ($ide_email) as slot $slot"
}

_restore_ide_session() {
    local dir="$1"
    [[ -f "$dir/ide-auth.json" ]] || die "$(label "$dir") has no captured IDE session (see: cursor-swap ide-add)"
    local sql; sql=$(jq -r "$_IDE_ROWS_TO_SQL" "$dir/ide-auth.json")
    # right after Cursor.app exits, a helper process can briefly still hold the
    # sqlite file lock - retry a couple times before giving up.
    local tries=0
    until sqlite3 "$IDE_DB" "$sql" 2>/dev/null; do
        (( tries++ >= 4 )) && die "couldn't write to $IDE_DB (still locked, or db format changed - undocumented, no stability guarantee)"
        sleep 1
    done
}

# does the actual quit -> write -> relaunch dance for a profile's IDE session.
# caller must have already confirmed $dir/ide-auth.json exists.
_do_ide_switch() {
    local dir="$1"
    [[ -f "$IDE_DB" ]] || die "$IDE_DB not found"

    local was_running=0
    if _ide_running; then
        was_running=1
        confirm "Cursor.app is running and must be fully quit to swap its session safely (all windows will close, then reopen). Continue?" \
            || { echo "aborted"; exit 1; }
        osascript -e 'quit app "Cursor"' >/dev/null 2>&1 || true
        local waited=0
        while _ide_running && (( waited < 15 )); do sleep 1; waited=$((waited + 1)); done
        _ide_running && die "Cursor.app didn't quit in time - close it manually and retry"
    fi

    _restore_ide_session "$dir"
    echo "Swapped IDE session to $(label "$dir")."
    if [[ "$was_running" == "1" ]]; then
        open -a "Cursor"
        echo "Relaunched Cursor.app."
    else
        echo "Cursor.app wasn't running - it'll pick this up next time it starts."
    fi
}

# switches the IDE session too, but only if this profile ever captured one
# (cursor-swap ide-add) - silent no-op otherwise, so plain CLI-only users see
# no difference.
_maybe_switch_ide() {
    local dir="$1"
    [[ -f "$dir/ide-auth.json" ]] || return 0
    _do_ide_switch "$dir"
}

cmd_ide_switch() {
    need_jq
    local ref="${1:?usage: cursor-swap ide-switch <slot|name|alias|email>}"
    local dir; dir=$(require_profile "$ref")
    [[ -f "$dir/ide-auth.json" ]] || die "$(label "$dir") has no captured IDE session (see: cursor-swap ide-add $ref)"
    _do_ide_switch "$dir"
}

# switches a single resolved profile dir to "current" - CLI session (if it
# has one), IDE session (if it has one), whichever applies. Shared by both
# `switch <ref>` and plain rotating `switch`.
_switch_profile() {
    local dir="$1"
    local type; type=$(jq -r '.type' "$dir/meta.json")
    case "$type" in
        api-key) die "$(label "$dir") is an api-key profile - global switch doesn't apply. Use: cursor-swap run $(basename "$dir") -- ..." ;;
        ide-only)
            echo "$(label "$dir") has no CLI session captured - switching the IDE session only."
            _maybe_switch_ide "$dir"
            local u; u=$(usage_summary "$(_any_access_token "$dir")" 2>/dev/null) || u=""
            [[ -n "$u" ]] && echo "Usage: $u"
            return 0
            ;;
    esac

    local target_email now_email
    target_email=$(jq -r '.email' "$dir/meta.json")
    now_email=$(current_email)
    # trust the cache only if the Keychain token it describes still exists -
    # if something cleared the Keychain out from under a stale cache (agent
    # logout bypassing cursor-swap, manual Keychain edits, etc.) a plain
    # cache-email match would wrongly skip the actual restore.
    if [[ "$now_email" == "$target_email" ]] && _has_cli_session; then
        echo "Already on $(label "$dir") ($target_email)"
    else
        _restore_session "$dir"
        echo "Swapped to $(label "$dir"). Verifying:"
        agent status
        _print_usage_line
    fi
    _maybe_switch_ide "$dir"
}

cmd_use() {
    need_jq
    local ref="${1:?usage: cursor-swap switch <slot|name|alias|email>}"
    local dir; dir=$(require_profile "$ref")
    _switch_profile "$dir"
}

_print_usage_line() {
    local u; u=$(usage_summary "$(security find-generic-password -s "$SVC_ACCESS" -a "$KC_ACCOUNT" -w 2>/dev/null)" 2>/dev/null) || return 0
    echo "Usage: $u"
}

_restore_session() {
    local dir="$1"
    security add-generic-password -U -s "$SVC_ACCESS"  -a "$KC_ACCOUNT" -w "$(cat "$dir/access-token")"  >/dev/null
    security add-generic-password -U -s "$SVC_REFRESH" -a "$KC_ACCOUNT" -w "$(cat "$dir/refresh-token")" >/dev/null
    jq -s '.[0] as $cur | .[1] as $saved | $cur
        | .authInfo = $saved.authInfo
        | .autoReviewAvailabilityCache = $saved.autoReviewAvailabilityCache
        | .serverConfigCache = $saved.serverConfigCache' \
        "$CONFIG" "$dir/cli-config.json" > "$CONFIG.tmp"
    mv "$CONFIG.tmp" "$CONFIG"
}

cmd_switch_next() {
    need_jq
    local dirs=() d now_email now_ide_email idx=-1 i=0
    now_email=$(current_email)
    now_ide_email=$(current_ide_email)
    while IFS= read -r d; do dirs+=("$d"); done < <(
        for m in "$STORE"/*/meta.json; do
            [[ -f "$m" ]] || continue
            jq -e 'select((.type=="session" or .type=="ide-only") and .enabled==true)' "$m" >/dev/null 2>&1 || continue
            jq -r '.slot' "$m"
        done | sort -n | while read -r s; do
            for m in "$STORE"/*/meta.json; do
                [[ "$(jq -r '.slot' "$m")" == "$s" ]] && dirname "$m"
            done
        done
    )
    [[ ${#dirs[@]} -gt 0 ]] || die "no session or IDE-only accounts saved (see: cursor-swap add)"
    # prefer matching by the current CLI session; fall back to the IDE one
    # (pure IDE-only setups have no CLI session to match at all).
    if _has_cli_session; then
        for i in "${!dirs[@]}"; do
            [[ "$(jq -r '.type' "${dirs[$i]}/meta.json")" == "session" && \
               "$(jq -r '.email' "${dirs[$i]}/meta.json")" == "$now_email" ]] && idx=$i && break
        done
    fi
    if [[ "$idx" == "-1" && -n "$now_ide_email" ]]; then
        for i in "${!dirs[@]}"; do
            [[ "$(jq -r '.ide_email // empty' "${dirs[$i]}/meta.json")" == "$now_ide_email" ]] && idx=$i && break
        done
    fi
    local next=$(( (idx + 1) % ${#dirs[@]} ))
    _switch_profile "${dirs[$next]}"
}

cmd_list() {
    need_jq; ensure_store
    local now_email now_ide_email
    now_email=$(current_email)
    now_ide_email=$(current_ide_email)
    local any=0
    echo "Accounts:"
    for m in "$STORE"/*/meta.json; do
        [[ -f "$m" ]] || continue
        any=1
        local dir slot email type enabled alias saved_at tag ide_email
        dir=$(dirname "$m")
        slot=$(jq -r '.slot' "$m"); email=$(jq -r '.email' "$m"); type=$(jq -r '.type' "$m")
        enabled=$(jq -r '.enabled' "$m"); alias=$(jq -r '.alias // empty' "$m"); saved_at=$(jq -r '.saved_at' "$m")
        ide_email=$(jq -r '.ide_email // empty' "$m")
        tag=""
        if [[ "$type" == "session" && "$email" == "$now_email" ]]; then tag=" (cli active)"; fi
        if [[ -n "$ide_email" && -n "$now_ide_email" && "$ide_email" == "$now_ide_email" ]]; then tag="$tag (ide active)"; fi
        [[ "$enabled" == "false" ]] && tag="$tag [disabled]"
        [[ "$type" == "api-key" ]] && tag="$tag [api-key, use: run]"
        [[ "$type" == "ide-only" ]] && tag="$tag [ide-only, use: ide-switch]"
        printf '  %-3s %-28s %s%s\n' "$slot:" "$email" "$([ -n "$alias" ] && echo "\"$alias\" ")" "$tag"
        printf '      saved: %s\n' "$saved_at"
        if [[ "$type" == "session" || "$type" == "ide-only" ]]; then
            local u; u=$(usage_summary "$(_any_access_token "$dir")" 2>/dev/null) || u=""
            [[ -n "$u" ]] && printf '      usage: %s\n' "$u"
        fi
        [[ -n "$ide_email" && "$type" != "ide-only" ]] && printf '      ide:   %s\n' "$ide_email"
    done
    [[ "$any" == "1" ]] || echo "  (none - use: cursor-swap add <name> / login <name> / add-token <key>)"
    echo
    echo "Note: usage % is from an undocumented Cursor API (best-effort, may show nothing"
    echo "      if a saved token expired - switch to that account to refresh it)."
}

cmd_status() { agent status; agent about; }

cmd_usage() {
    need_jq
    local ref="${1:-}" token label_str
    if [[ -n "$ref" ]]; then
        local dir; dir=$(require_profile "$ref")
        local type; type=$(jq -r '.type' "$dir/meta.json")
        [[ "$type" == "session" || "$type" == "ide-only" ]] \
            || die "$(label "$dir") has no CLI or IDE session captured (type: $type) - usage % needs one"
        token=$(_any_access_token "$dir")
        [[ -n "$token" ]] || die "no stored access-token for $(label "$dir")"
        label_str=$(label "$dir")
    else
        token=$(security find-generic-password -s "$SVC_ACCESS" -a "$KC_ACCOUNT" -w 2>/dev/null)
        if [[ -n "$token" ]]; then
            label_str="$(current_email) (cli active)"
        else
            token=$(sqlite3 "$IDE_DB" "SELECT value FROM ItemTable WHERE key='cursorAuth/accessToken';" 2>/dev/null)
            [[ -n "$token" ]] || die "no active CLI or IDE session (see: cursor-swap switch)"
            label_str="$(current_ide_email) (ide active)"
        fi
    fi
    local u; u=$(usage_summary "$token") || die "usage lookup failed - token may be expired, or Cursor's internal API changed (undocumented, no stability guarantee)"
    echo "$label_str: $u"
}

cmd_remove() {
    local ref="${1:?usage: cursor-swap remove <slot|name|alias|email>}"
    local dir; dir=$(require_profile "$ref")
    local lbl; lbl=$(label "$dir")
    confirm "Delete saved profile $lbl?" || { echo "aborted"; exit 1; }
    rm -rf "$dir"
    echo "Removed $lbl"
}

cmd_enable_disable() {
    need_jq
    local state="$1" ref="${2:?usage: cursor-swap $1 <slot|name|alias|email>}"
    local dir; dir=$(require_profile "$ref")
    jq --argjson v "$state" '.enabled = $v' "$dir/meta.json" > "$dir/meta.json.tmp" && mv "$dir/meta.json.tmp" "$dir/meta.json"
    echo "$([ "$state" == "true" ] && echo Enabled || echo Disabled) $(label "$dir")"
}

cmd_alias() {
    need_jq
    if [[ $# -eq 0 ]]; then
        for m in "$STORE"/*/meta.json; do
            [[ -f "$m" ]] || continue
            local a; a=$(jq -r '.alias // empty' "$m")
            [[ -n "$a" ]] && printf '  %-15s -> %s\n' "$a" "$(jq -r '.email' "$m")"
        done
        return
    fi
    local ref="$1"; local dir; dir=$(require_profile "$ref")
    if [[ "${2:-}" == "--unset" ]]; then
        jq '.alias = null' "$dir/meta.json" > "$dir/meta.json.tmp" && mv "$dir/meta.json.tmp" "$dir/meta.json"
        echo "Unset alias for $(basename "$dir")"
    else
        local newalias="${2:?usage: cursor-swap alias <slot|name> <short>}"
        jq --arg a "$newalias" '.alias = $a' "$dir/meta.json" > "$dir/meta.json.tmp" && mv "$dir/meta.json.tmp" "$dir/meta.json"
        echo "Alias '$newalias' -> $(basename "$dir")"
    fi
}

cmd_map() {
    need_jq; ensure_store
    if [[ $# -eq 0 ]]; then
        jq -r 'to_entries[] | "  \(.value)  ->  \(.key)"' "$MAPFILE"
        return
    fi
    local ref="$1" path="${2:-$PWD}"
    local dir; dir=$(require_profile "$ref")
    path=$(cd "$path" && pwd)
    jq --arg p "$path" --arg n "$(basename "$dir")" '.[$p] = $n' "$MAPFILE" > "$MAPFILE.tmp" && mv "$MAPFILE.tmp" "$MAPFILE"
    echo "Mapped $path -> $(label "$dir")"
}

cmd_unmap() {
    need_jq; ensure_store
    local path="${1:-$PWD}"; path=$(cd "$path" && pwd)
    jq --arg p "$path" 'del(.[$p])' "$MAPFILE" > "$MAPFILE.tmp" && mv "$MAPFILE.tmp" "$MAPFILE"
    echo "Unmapped $path"
}

mapped_profile_for_cwd() {
    need_jq; ensure_store
    local dir="$PWD"
    while [[ "$dir" != "/" ]]; do
        local name; name=$(jq -r --arg p "$dir" '.[$p] // empty' "$MAPFILE")
        [[ -n "$name" ]] && { echo "$name"; return; }
        dir=$(dirname "$dir")
    done
}

cmd_run() {
    local ref="${1:-}"
    if [[ -n "$ref" && "$ref" != "--" ]]; then shift; else ref=$(mapped_profile_for_cwd) || true; [[ "${1:-}" == "--" ]] && shift; fi
    [[ -n "$ref" ]] || die "no account given and no directory mapping for $PWD (see: cursor-swap map)"
    local dir; dir=$(require_profile "$ref")
    local type; type=$(jq -r '.type' "$dir/meta.json")

    if [[ "$type" == "api-key" ]]; then
        exec agent --api-key "$(cat "$dir/api-key")" "$@"
    fi
    [[ "$type" == "session" ]] || die "$(label "$dir") only has an IDE session captured, no CLI session to run with."

    # session type: no real per-terminal isolation exists (Keychain is
    # OS-user-global; CURSOR_DATA_DIR was tested and does NOT scope auth).
    # Best effort: swap in, run, swap back to whatever was active before.
    echo "warning: $(label "$dir") is a session account - 'run' will swap the global CLI session," >&2
    echo "         execute, then swap back. Other terminals using cursor-agent during this window" >&2
    echo "         will see the wrong account. Prefer an api-key profile for concurrent use." >&2
    confirm "Continue?" || { echo "aborted"; exit 1; }

    local prev_email prev_dir
    prev_email=$(current_email)
    prev_dir=""
    for m in "$STORE"/*/meta.json; do
        [[ -f "$m" ]] || continue
        [[ "$(jq -r '.email' "$m")" == "$prev_email" ]] && prev_dir=$(dirname "$m") && break
    done

    _restore_session "$dir"
    local status=0
    agent "$@" || status=$?

    if [[ -n "$prev_dir" ]]; then
        _restore_session "$prev_dir"
    else
        echo "note: previous session ($prev_email) wasn't a saved profile - not restored. Run 'cursor-swap add <name>' beforehand next time." >&2
    fi
    exit $status
}

cmd_export() {
    local path="${1:?usage: cursor-swap export <path.tar.gz>}"
    ensure_store
    tar czf "$path" -C "$STORE" .
    chmod 600 "$path"
    echo "Exported $(ls "$STORE" | wc -l | tr -d ' ') profile dir(s) to $path"
    echo "warning: this archive contains plaintext tokens/api keys - handle like a password file."
}

cmd_import() {
    local path="${1:?usage: cursor-swap import <path.tar.gz>}"
    ensure_store
    [[ -f "$path" ]] || die "$path not found"
    local tmp; tmp=$(mktemp -d)
    tar xzf "$path" -C "$tmp"
    local d name
    for d in "$tmp"/*/; do
        [[ -f "$d/meta.json" ]] || continue
        name=$(basename "$d")
        if [[ -d "$STORE/$name" && "${FORCE:-0}" != "1" ]]; then
            echo "skip '$name' (exists, use --force to overwrite)"
            continue
        fi
        rm -rf "$STORE/$name"
        cp -R "$d" "$STORE/$name"
        chmod 700 "$STORE/$name"
        chmod 600 "$STORE/$name"/*token "$STORE/$name"/api-key 2>/dev/null || true
        echo "imported '$name'"
    done
    rm -rf "$tmp"
}

cmd_purge() {
    confirm "Delete ALL cursor-swap data in $STORE?" || { echo "aborted"; exit 1; }
    rm -rf "$STORE"
    echo "Purged $STORE"
}

cmd_version() { echo "cursor-swap $VERSION"; }

cmd_update() {
    local self="$0"
    case "$self" in
        /*) ;;
        *) self="$(command -v -- "$self" 2>/dev/null || echo "$PWD/$self")" ;;
    esac
    [[ -w "$self" ]] || die "$self not writable - re-run with sufficient permissions"

    local tmp; tmp=$(mktemp)
    curl -fsSL "$RAW_BASE/cursor-swap" -o "$tmp" || { rm -f "$tmp"; die "download failed"; }
    chmod +x "$tmp"

    if cmp -s "$tmp" "$self"; then
        rm -f "$tmp"
        echo "cursor-swap is already up to date ($VERSION)"
        return
    fi
    local new_version; new_version=$(grep -m1 '^VERSION=' "$tmp" | cut -d'"' -f2 || true)
    mv "$tmp" "$self"
    echo "Updated cursor-swap: $VERSION -> ${new_version:-unknown}"
}

usage() {
    cat <<EOF
cursor-swap - multi-account switcher for cursor-agent CLI

Commands:
  cursor-swap list                    list saved accounts (marks active)
  cursor-swap status                  show current login + subscription info
  cursor-swap usage [slot|name|...]   show usage % for that account (default: active).
                                       undocumented Cursor API, best-effort, may be empty
  cursor-swap switch                  rotate to the next enabled account (CLI, IDE-only,
                                       or both - works with IDE-only setups too)
  cursor-swap switch <slot|name|...>  swap the global CLI session to that account.
                                       also swaps the Cursor.app IDE session if this
                                       profile ever had 'ide-add' run on it (quits +
                                       relaunches the app, confirms first)
  cursor-swap add <name> [--alias A]  save the currently logged-in session(s) as <name>.
                                       captures CLI, IDE, or both - whichever is logged in
                                       (fine if you only use one of the two)
  cursor-swap login <name>            logout -> browser login -> save as <name> (CLI only)
  cursor-swap add-token <key|-> [--email E] [--alias A]
                                       register a Cursor API key (no browser login,
                                       usable concurrently via 'run')
  cursor-swap ide-add <name> [--alias A]
                                       snapshot ONLY the IDE session as <name> (plain
                                       'add' already does this too if the IDE is logged
                                       in - use this to (re-)capture just the IDE side)
  cursor-swap ide-switch <slot|name|...>
                                       swap the Cursor.app IDE session to that account.
                                       quits + relaunches the app (confirms first,
                                       closes ALL open IDE windows during the swap)
  cursor-swap remove <slot|name|...>  delete a saved account       (alias: rm)
  cursor-swap disable <slot|name|...> hold out of 'switch' rotation
  cursor-swap enable <slot|name|...>  return to rotation
  cursor-swap run <slot|name> [-- args...]
                                       run 'agent' as that account.
                                       api-key accounts: real per-invocation isolation.
                                       session accounts: swaps global state, runs, swaps
                                       back - NOT safe for concurrent terminals.
  cursor-swap run [-- args...]        run using the account mapped to \$PWD
  cursor-swap map <slot|name> [path]  map a directory to an account (default: \$PWD)
  cursor-swap map                     list directory mappings
  cursor-swap unmap [path]            remove a directory mapping
  cursor-swap alias <slot|name> <short>
  cursor-swap alias <slot|name> --unset
  cursor-swap alias                   list aliases
  cursor-swap export <path.tar.gz>    back up all accounts (contains secrets)
  cursor-swap import <path.tar.gz> [--force]
  cursor-swap purge                   delete all cursor-swap data
  cursor-swap update                  download latest cursor-swap from GitHub and replace self
  cursor-swap version                 print the installed version    (alias: --version, -v)

Flags:
  -y, --yes     skip confirmation prompts
  --force       with 'import': overwrite existing accounts

Usage %: 'list'/'switch'/'usage' call an undocumented Cursor backend API (the same
one the CLI's own JS bundle uses) with your stored access-token. Not public, no
stability guarantee - may silently return nothing if Cursor changes it.

IDE account: Cursor.app (the desktop editor) has its OWN separate login from the
CLI - can be a different account. ide-add/ide-switch manage it independently, by
reading/writing plaintext auth rows in the app's own local sqlite db. Also an
undocumented on-disk format, same no-stability-guarantee caveat as usage %.

Not implemented, on purpose:
  auto (quota-based auto-switch), tui/watch/menubar (dashboards) - not worth building
    automation on an undocumented endpoint that can break silently.
  slot renumbering - slots are stable ids; use aliases instead.

Data: $STORE (plaintext tokens/keys, chmod 600 - same trust model as
cursor-agent's own on-disk config)
EOF
}

YES=0; FORCE=0
args=()
for a in "$@"; do
    case "$a" in
        -y|--yes) YES=1 ;;
        --force) FORCE=1 ;;
        *) args+=("$a") ;;
    esac
done
set -- "${args[@]:-}"

case "${1:-}" in
    add)         shift; cmd_add "$@" ;;
    login)       shift; cmd_login "$@" ;;
    add-token)   shift; cmd_add_token "$@" ;;
    ide-add)     shift; cmd_ide_add "$@" ;;
    ide-switch|ide-use) shift; cmd_ide_switch "$@" ;;
    switch)      shift; if [[ $# -eq 0 ]]; then cmd_switch_next; else cmd_use "$@"; fi ;;
    use)         shift; cmd_use "$@" ;;
    list|ls)     cmd_list ;;
    status|current) cmd_status ;;
    usage)       shift; cmd_usage "$@" ;;
    remove|rm)   shift; cmd_remove "$@" ;;
    disable)     shift; cmd_enable_disable false "$@" ;;
    enable)      shift; cmd_enable_disable true "$@" ;;
    run)         shift; cmd_run "$@" ;;
    map)         shift; cmd_map "$@" ;;
    unmap)       shift; cmd_unmap "$@" ;;
    alias)       shift; cmd_alias "$@" ;;
    export)      shift; cmd_export "$@" ;;
    import)      shift; cmd_import "$@" ;;
    purge)       cmd_purge ;;
    update)      cmd_update ;;
    version|--version|-v) cmd_version ;;
    ""|-h|--help|help) usage ;;
    *) die "unknown command '$1' (see: cursor-swap --help)" ;;
esac
