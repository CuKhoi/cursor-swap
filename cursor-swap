#!/usr/bin/env bash
# Compatibility shim - cursor-swap was renamed to cursorswap (no hyphen).
#
# Why this file still exists: an old install's own `cursor-swap update`
# fetches this exact path from GitHub and overwrites itself with whatever's
# here. So this file has to keep existing at this path forever (or at least
# a long time), and has to be a working `cursor-swap` - it can't just vanish
# or every pre-rename install's self-update breaks.
#
# What it does: forwards to `cursorswap` if already present next to it,
# otherwise downloads it once, then forwards. Never touches ~/.cursor-accounts
# (the actual account data) - that's untouched by anything in this file.
set -euo pipefail

RAW_BASE="https://raw.githubusercontent.com/CuKhoi/cursor-swap/main"

self="$0"
case "$self" in
    /*) ;;
    *) self="$(command -v -- "$self" 2>/dev/null || echo "$PWD/$self")" ;;
esac
dir="$(dirname "$self")"
target="$dir/cursorswap"

if [[ ! -x "$target" ]]; then
    echo "note: cursor-swap was renamed to cursorswap - fetching it (one-time)..." >&2
    tmp=$(mktemp)
    if curl -fsSL "$RAW_BASE/cursorswap" -o "$tmp"; then
        chmod +x "$tmp"
        mv "$tmp" "$target"
    else
        rm -f "$tmp"
        echo "error: couldn't download cursorswap - check your connection and try again," >&2
        echo "       or install manually: curl -fsSL $RAW_BASE/install.sh | bash" >&2
        exit 1
    fi
fi

echo "note: 'cursor-swap' is now 'cursorswap' (no hyphen) - use that going forward." >&2
exec "$target" "$@"
