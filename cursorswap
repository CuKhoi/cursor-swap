#!/usr/bin/env bash
# cursorswap: multi-account switcher for cursor-agent CLI
#
# Two account types:
#   session  - a real browser login (email/password/SSO). Swapping overwrites the
#              CLI's Keychain items (cursor-access-token / cursor-refresh-token,
#              account cursor-user) + cached authInfo in ~/.cursor/cli-config.json.
#              This is GLOBAL state: only one session account can be "active" at a
#              time on this machine, and swapping mid-session in one terminal
#              affects `agent` in every other terminal too.
#   api-key  - a Cursor API key (agent --api-key / $CURSOR_API_KEY). Never touches
#              global state - passed per-invocation, so `run` with an api-key
#              profile is safe to use concurrently in multiple terminals.
#
# IDE account (ide-add/ide-switch): Cursor.app (the desktop editor) is a SEPARATE
# login from the CLI - can be on a different account entirely. Its session lives as
# plaintext cursorAuth/accessToken + cursorAuth/refreshToken rows in the app's own
# sqlite db (User/globalStorage/state.vscdb, ItemTable), found by reading that file
# after quitting the app (WAL wasn't checkpointed while it ran) - not the "Cursor
# Safe Storage" Keychain item, which is Electron's own encryption key for unrelated
# things. UNDOCUMENTED on-disk format - can change on a Cursor update. Swapping
# requires the app fully quit first (live process can overwrite the write, and it
# only reads auth off disk at startup) - ide-switch quits it for you (with confirm)
# and relaunches after.
#
# Usage %: `agent status`/`agent about` expose none, but the CLI's own JS bundle
# calls an undocumented backend RPC (aiserver.v1.DashboardService/GetCurrentPeriodUsage)
# with the same Bearer access-token cursorswap already stores per profile. list/switch/
# usage call it best-effort. UNDOCUMENTED - not a public API, no stability guarantee,
# can silently break on a Cursor update.
#
# `watch` (repeats `list`) and `renumber` (closes slot-number gaps) ARE
# implemented - both fit fine as plain bash.
#
# NOT implemented, on purpose (not just missing):
#   auto - auto-switch by remaining quota. The usage % above comes from an
#          undocumented endpoint; building an automated strategy on top of
#          something that can break silently is a step too far. Use
#          `cursorswap usage`/`watch` yourself and switch manually.
#   tui (full-screen interactive UI) / menubar (macOS menu-bar app) - wrong
#          distribution model for a single self-updating bash script. A TUI
#          needs a Python+Textual runtime and a second install path; a
#          menubar app needs its own Swift/rumps build, code signing, and
#          notarization. Would be a separate project, not a feature of this
#          file.

# cursorswap needs bash 4+ (associative arrays, for i18n). macOS ships bash
# 3.2 as /bin/bash - Apple froze it there in ~2007 over GPLv3, and never
# updated it since. `#!/usr/bin/env bash` finds whatever's first in PATH,
# which on a stock Mac (no Homebrew bash installed) is that 3.2. Without this
# guard the script just dies on the first `declare -A` with a cryptic
# "declare: -A: invalid option" instead of a useful message. Written in
# bash-3.2-safe syntax on purpose - it has to run correctly UNDER 3.2 before
# it's decided whether to re-exec into something newer.
if [ -z "${CURSORSWAP_REEXEC:-}" ] && [ "${BASH_VERSINFO[0]:-0}" -lt 4 ] 2>/dev/null; then
    for _cursorswap_candidate in /opt/homebrew/bin/bash /usr/local/bin/bash "$(command -v bash 2>/dev/null)"; do
        if [ -n "$_cursorswap_candidate" ] && [ -x "$_cursorswap_candidate" ]; then
            # shellcheck disable=SC2016  # single-quoted on purpose: evaluated by the candidate bash, not this one
            _v=$("$_cursorswap_candidate" -c 'echo "${BASH_VERSINFO[0]}"' 2>/dev/null)
            if [ -n "$_v" ] && [ "$_v" -ge 4 ] 2>/dev/null; then
                CURSORSWAP_REEXEC=1 exec "$_cursorswap_candidate" "$0" "$@"
            fi
        fi
    done
    echo "error: cursorswap needs bash 4 or newer - this system's bash ($BASH) is $BASH_VERSION." >&2
    echo "       Install a newer one with: brew install bash" >&2
    exit 1
fi

