# ---- color palette --------------------------------------------------------
# Single warm accent (xterm-256 173, same terracotta tone claude-swap's CLI
# printer uses), muted gray for secondary text, bold for structure, a
# green/amber/red severity ramp for usage %. Off for NO_COLOR, non-tty, or
# TERM=dumb; on for FORCE_COLOR. Same convention as claude-swap's printer.py.
_supports_color() {
    [[ -n "${NO_COLOR:-}" ]] && return 1
    [[ -n "${FORCE_COLOR:-}" ]] && return 0
    [[ -t 1 ]] || return 1
    [[ "${TERM:-}" == "dumb" ]] && return 1
    return 0
}
if _supports_color; then
    C_RESET=$'\033[0m'; C_BOLD=$'\033[1m'; C_DIM=$'\033[2m'
    C_ACCENT=$'\033[38;5;173m'; C_MUTED=$'\033[38;5;250m'
    C_RED=$'\033[31m'; C_YELLOW=$'\033[33m'
    C_OK=$'\033[38;5;108m'; C_WARN=$'\033[38;5;179m'; C_CRIT=$'\033[38;5;167m'
else
    C_RESET=""; C_BOLD=""; C_DIM=""
    C_ACCENT=""; C_MUTED=""
    C_RED=""; C_YELLOW=""
    C_OK=""; C_WARN=""; C_CRIT=""
fi
_accent() { printf '%s%s%s' "$C_ACCENT" "$1" "$C_RESET"; }
_muted()  { printf '%s%s%s' "$C_MUTED" "$1" "$C_RESET"; }
_dimmed() { printf '%s%s%s' "$C_DIM" "$1" "$C_RESET"; }
_bold_accent() { printf '%s%s%s%s' "$C_BOLD" "$C_ACCENT" "$1" "$C_RESET"; }
_bold()   { printf '%s%s%s' "$C_BOLD" "$1" "$C_RESET"; }
# colors a "N" percent value green/amber/red by the same 70/90 thresholds
# claude-swap's usage bars use, and appends the "%" itself.
_sev_pct() {
    local p="$1" color
    color=$(awk -v p="$p" 'BEGIN{ if (p>=90) print "CRIT"; else if (p>=70) print "WARN"; else print "OK" }')
    case "$color" in CRIT) color="$C_CRIT" ;; WARN) color="$C_WARN" ;; *) color="$C_OK" ;; esac
    printf '%s%s%%%s' "$color" "$p" "$C_RESET"
}

# ---- i18n ------------------------------------------------------------------
# CURSOR_SWAP_LANG=vi (or --lang vi) switches user-facing text to Vietnamese.
# Falls back to English for any key missing from MSG_VI, and to the key
# itself if somehow missing from MSG_EN too - _t() never returns empty or
# fails, so a missed translation degrades to readable English instead of a
# blank line or (under `set -e`) killing the script outright.
#
# Uses {1}/{2}/... placeholders instead of printf %-specifiers: several
# messages contain a literal "%" (e.g. "usage %"), which a printf format
# string would misparse as a conversion spec.
declare -A MSG_EN=() MSG_VI=()
CURSOR_SWAP_LANG="${CURSOR_SWAP_LANG:-en}"

_t() {
    local key="$1"; shift
    local msg="${MSG_EN[$key]:-$key}"
    [[ "$CURSOR_SWAP_LANG" == "vi" && -n "${MSG_VI[$key]:-}" ]] && msg="${MSG_VI[$key]}"
    local i=1 v
    for v in "$@"; do
        msg="${msg//\{$i\}/$v}"
        i=$((i + 1))
    done
    printf '%s' "$msg"
}

MSG_EN[aborted]="aborted"
MSG_VI[aborted]="đã huỷ"
MSG_EN[jq_required]="jq required"
MSG_VI[jq_required]="cần có jq"

die() { echo "${C_RED}$(_t err_prefix)$*${C_RESET}" >&2; exit 1; }
MSG_EN[err_prefix]="error: "
MSG_VI[err_prefix]="lỗi: "
need_jq() { command -v jq >/dev/null || die "$(_t jq_required)"; }

confirm() {
    [[ "${YES:-0}" == "1" ]] && return 0
    read -r -p "${C_YELLOW}$1${C_RESET} $(_t confirm_suffix) " ans
    if [[ "$CURSOR_SWAP_LANG" == "vi" ]]; then
        [[ "$ans" =~ ^[Cc]$ ]]
    else
        [[ "$ans" =~ ^[Yy]$ ]]
    fi
}
