usage() {
    cat <<EOF | sed -E "s/^(  cursorswap [a-zA-Z][a-zA-Z-]*)/${C_ACCENT}\\1${C_RESET}/"
${C_BOLD}$(_t hdr_title)${C_RESET}

${C_BOLD}$(_t hdr_commands)${C_RESET}
  cursorswap list                    $(_t desc_list)
  cursorswap status                  $(_t desc_status)
  cursorswap usage [slot|name|...]   $(_t desc_usage)
  cursorswap switch                  $(_t desc_switch_rotate)
  cursorswap switch <slot|name|...>  $(_t desc_switch_ref)
  cursorswap add <name> [--alias A]  $(_t desc_add)
  cursorswap login <name>            $(_t desc_login)
  cursorswap add-token <key|-> [--email E] [--alias A]
                                       $(_t desc_add_token)
  cursorswap ide-add <name> [--alias A]
                                       $(_t desc_ide_add)
  cursorswap ide-switch <slot|name|...>
                                       $(_t desc_ide_switch)
  cursorswap remove <slot|name|...>  $(_t desc_remove)
  cursorswap disable <slot|name|...> $(_t desc_disable)
  cursorswap enable <slot|name|...>  $(_t desc_enable)
  cursorswap run <slot|name> [-- args...]
                                       $(_t desc_run)
  cursorswap run [-- args...]        $(_t desc_run_mapped)
  cursorswap map <slot|name> [path]  $(_t desc_map)
  cursorswap map                     $(_t desc_map_list)
  cursorswap unmap [path]            $(_t desc_unmap)
  cursorswap alias <slot|name> <short>
  cursorswap alias <slot|name> --unset
  cursorswap alias                   $(_t desc_alias_list)
  cursorswap export <path.tar.gz>    $(_t desc_export)
  cursorswap import <path.tar.gz> [--force]
  cursorswap purge                   $(_t desc_purge)
  cursorswap update                  $(_t desc_update)
  cursorswap version                 $(_t desc_version)
  cursorswap watch [seconds]         $(_t desc_watch)
  cursorswap renumber                $(_t desc_renumber)
  cursorswap lang                    $(_t desc_lang)

${C_BOLD}$(_t hdr_flags)${C_RESET}
  -y, --yes       $(_t flag_yes)
  --force         $(_t flag_force)
  -l, --lang <l>  $(_t flag_lang)

${C_MUTED}$(_t help_usage_pct)${C_RESET}

${C_MUTED}$(_t help_ide_account)${C_RESET}

${C_BOLD}$(_t hdr_not_implemented)${C_RESET}
  $(_t help_not_implemented)

${C_MUTED}$(_t help_data "$STORE")${C_RESET}
EOF
}

YES="${CURSOR_SWAP_YES:-0}"; FORCE=0
args=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        -y|--yes) YES=1; shift ;;
        --force) FORCE=1; shift ;;
        -l|--lang) CURSOR_SWAP_LANG="${2:-en}"; shift 2 ;;
        --lang=*) CURSOR_SWAP_LANG="${1#--lang=}"; shift ;;
        *) args+=("$1"); shift ;;
    esac
done
set -- "${args[@]:-}"

case "${1:-}" in
    add)         shift; cmd_add "$@" ;;
    login)       shift; cmd_login "$@" ;;
    add-token)   shift; cmd_add_token "$@" ;;
    ide-add)     shift; cmd_ide_add "$@" ;;
    ide-switch|ide-use) shift; cmd_ide_switch "$@" ;;
    switch)      shift; if [[ $# -eq 0 ]]; then cmd_switch_next; else cmd_use "$@"; fi ;;
    use)         shift; cmd_use "$@" ;;
    list|ls)     cmd_list ;;
    status|current) cmd_status ;;
    usage)       shift; cmd_usage "$@" ;;
    remove|rm)   shift; cmd_remove "$@" ;;
    disable)     shift; cmd_enable_disable false "$@" ;;
    enable)      shift; cmd_enable_disable true "$@" ;;
    run)         shift; cmd_run "$@" ;;
    map)         shift; cmd_map "$@" ;;
    unmap)       shift; cmd_unmap "$@" ;;
    alias)       shift; cmd_alias "$@" ;;
    export)      shift; cmd_export "$@" ;;
    import)      shift; cmd_import "$@" ;;
    purge)       cmd_purge ;;
    update)      cmd_update ;;
    version|--version|-v) cmd_version ;;
    lang)        cmd_lang ;;
    watch)       shift; cmd_watch "$@" ;;
    renumber)    cmd_renumber ;;
    ""|-h|--help|help) usage ;;
    *) die "$(_t err_unknown_command "$1")" ;;
esac
