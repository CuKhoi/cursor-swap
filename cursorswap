current_email() {
    [[ -f "$CONFIG" ]] && jq -r '.authInfo.email // "unknown"' "$CONFIG" 2>/dev/null || echo "unknown"
}

current_ide_email() {
    [[ -f "$IDE_DB" ]] || return
    local email; email=$(sqlite3 "$IDE_DB" "SELECT value FROM ItemTable WHERE key='cursorAuth/cachedEmail';" 2>/dev/null || true)
    if [[ -z "$email" ]]; then
        # cachedEmail can lag behind a fresh login for a bit - fall back to
        # matching the token's auth0 sub against a saved CLI profile's authId.
        local sub token
        token=$(sqlite3 "$IDE_DB" "SELECT value FROM ItemTable WHERE key='cursorAuth/accessToken';" 2>/dev/null || true)
        sub=$(_jwt_sub "$token")
        if [[ -n "$sub" ]]; then
            for cfg in "$STORE"/*/cli-config.json; do
                [[ -f "$cfg" ]] || continue
                if [[ "$(jq -r '.authInfo.authId // empty' "$cfg" 2>/dev/null)" == "$sub" ]]; then
                    email=$(jq -r '.authInfo.email' "$cfg")
                    break
                fi
            done
        fi
    fi
    echo "$email"
}

ensure_store() { mkdir -p "$STORE"; chmod 700 "$STORE"; [[ -f "$MAP_FILE" ]] || echo '{}' > "$MAP_FILE"; }

next_slot() {
    local max=0 s
    for m in "$STORE"/*/meta.json; do
        [[ -f "$m" ]] || continue
        s=$(jq -r '.slot // 0' "$m")
        (( s > max )) && max=$s
    done
    echo $((max + 1))
}

# echoes the profile dir for a slot number / name / alias / email, or nothing
resolve_profile() {
    local ref="$1" dir name
    for dir in "$STORE"/*/; do
        [[ -f "$dir/meta.json" ]] || continue
        name=$(basename "$dir")
        if [[ "$name" == "$ref" ]]; then echo "${dir%/}"; return; fi
        if [[ "$(jq -r '.slot' "$dir/meta.json")" == "$ref" ]]; then echo "${dir%/}"; return; fi
        if [[ "$(jq -r '.alias // empty' "$dir/meta.json")" == "$ref" ]]; then echo "${dir%/}"; return; fi
        if [[ "$(jq -r '.email' "$dir/meta.json")" == "$ref" ]]; then echo "${dir%/}"; return; fi
    done
}

require_profile() {
    local ref="$1" dir
    dir=$(resolve_profile "$ref")
    [[ -n "$dir" ]] || die "$(_t err_no_match "$ref")"
    echo "$dir"
}

label() {
    local dir="$1" name alias
    name=$(basename "$dir")
    alias=$(jq -r '.alias // empty' "$dir/meta.json")
    if [[ -n "$alias" ]]; then
        echo "$(_accent "$name") $(_muted "($alias)")"
    else
        _accent "$name"
    fi
}

# any access token this profile has, CLI's or the IDE's - the usage-% API
# doesn't care which surface a token came from, it's the same backend.
_any_access_token() {
    local dir="$1"
    if [[ -f "$dir/access-token" ]]; then
        cat "$dir/access-token" 2>/dev/null
    elif [[ -f "$dir/ide-auth.json" ]]; then
        jq -r '.[] | select(.key=="cursorAuth/accessToken") | .value' "$dir/ide-auth.json" 2>/dev/null
    fi
}

# best token to use for usage-% on this profile: if it's the CURRENTLY active
# one (CLI or IDE), read the live token instead of the snapshot - Cursor
# rotates access tokens over time even while a session stays logged in, so a
# snapshot from whenever add/ide-add ran can go stale while still "active".
# Falls back to the snapshot for anything not currently active.
_effective_access_token() {
    local dir="$1" type email ide_email
    type=$(jq -r '.type' "$dir/meta.json")
    email=$(jq -r '.email' "$dir/meta.json")
    ide_email=$(jq -r '.ide_email // empty' "$dir/meta.json")

    if [[ "$type" == "session" && "$email" == "$(current_email)" ]] && _has_cli_session; then
        local tok; tok=$(security find-generic-password -s "$SVC_ACCESS" -a "$KC_ACCOUNT" -w 2>/dev/null)
        [[ -n "$tok" ]] && { echo "$tok"; return; }
    fi
    if [[ -n "$ide_email" ]]; then
        local now_ide; now_ide=$(current_ide_email)
        if [[ -n "$now_ide" && "$ide_email" == "$now_ide" ]]; then
            local tok; tok=$(sqlite3 "$IDE_DB" "SELECT value FROM ItemTable WHERE key='cursorAuth/accessToken';" 2>/dev/null || true)
            [[ -n "$tok" ]] && { echo "$tok"; return; }
        fi
    fi
    _any_access_token "$dir"
}

# best-effort: on success prints "  total: N%  auto: N%  api: N%" for a given
# access token and exits 0. On failure prints a short human reason and exits 1 -
# callers show that reason in place of the %, so "session revoked, go log in
# again" is distinguishable from a network blip. It used to collapse every
# failure into a silent `return 1`, which rendered as an empty line and left
# users with no idea why a profile showed no usage.
#
# Saved IDE session tokens in particular come back HTTP 401
# (code "unauthenticated" / ERROR_NOT_LOGGED_IN) long before their JWT `exp`,
# because Cursor revokes them server-side; there is no recovery path here since
# the IDE's cursorAuth/refreshToken is byte-identical to its accessToken (it is
# one session token stored twice, not a real refresh grant).
usage_summary() {
    local token="$1" resp code body
    [[ -n "$token" ]] || { _t usage_err_no_token; return 1; }
    # -w appends the status on its own last line, so a failing request still
    # tells us *how* it failed rather than just "non-2xx happened somewhere".
    resp=$(curl -sS --max-time 4 -w $'\n%{http_code}' -X POST "$API_BASE/aiserver.v1.DashboardService/GetCurrentPeriodUsage" \
        -H "Authorization: Bearer $token" -H "Content-Type: application/json" \
        -H "Connect-Protocol-Version: 1" -d '{}' 2>/dev/null) || { _t usage_err_network; return 1; }
    code="${resp##*$'\n'}"
    body="${resp%$'\n'*}"
    case "$code" in
        200) ;;
        401|403) _t usage_err_revoked; return 1 ;;
        *) _t usage_err_http "$code"; return 1 ;;
    esac
    jq -e '.planUsage.totalPercentUsed' <<<"$body" >/dev/null 2>&1 || { _t usage_err_shape; return 1; }
    local total auto api
    read -r total auto api < <(jq -r 'def r1: (.*10|round)/10;
        .planUsage | "\((.totalPercentUsed // 0)|r1) \((.autoPercentUsed // 0)|r1) \((.apiPercentUsed // 0)|r1)"' <<<"$body")
    printf '%s %s  %s %s  %s %s' \
        "$(_muted total:)" "$(_sev_pct "$total")" \
        "$(_muted auto:)"  "$(_sev_pct "$auto")" \
        "$(_muted api:)"   "$(_sev_pct "$api")"
}

# renders the usage field for display: the coloured % on success, the muted
# failure reason otherwise. Never non-zero - usage % is always best-effort and
# must not abort a switch or a listing.
_usage_field() {
    local out rc=0
    out=$(usage_summary "$1") || rc=$?
    if (( rc == 0 )); then printf '%s' "$out"; else _muted "$out"; fi
}

# ---- capture a live session account into a profile dir ----
capture_session() {
    local name="$1" access refresh email dir alias="${2:-}"
    access=$(security find-generic-password -s "$SVC_ACCESS" -a "$KC_ACCOUNT" -w 2>/dev/null) || die "$(_t err_no_cli_access)"
    refresh=$(security find-generic-password -s "$SVC_REFRESH" -a "$KC_ACCOUNT" -w 2>/dev/null) || die "$(_t err_no_cli_refresh)"
    [[ -f "$CONFIG" ]] || die "$(_t err_config_not_found "$CONFIG")"
    email=$(current_email)

    dir="$STORE/$name"
    local slot
    if [[ -d "$dir" ]]; then
        confirm "$(_t confirm_overwrite "$name" "$(jq -r '.email' "$dir/meta.json" 2>/dev/null || echo '?')")" || { echo "$(_t aborted)"; exit 1; }
        slot=$(jq -r '.slot' "$dir/meta.json")
        [[ -z "$alias" ]] && alias=$(jq -r '.alias // empty' "$dir/meta.json")
    else
        slot=$(next_slot)
    fi
    mkdir -p "$dir"; chmod 700 "$dir"
    printf '%s' "$access"  > "$dir/access-token";  chmod 600 "$dir/access-token"
    printf '%s' "$refresh" > "$dir/refresh-token"; chmod 600 "$dir/refresh-token"
    cp "$CONFIG" "$dir/cli-config.json"
    jq -n --arg email "$email" --arg ts "$(date -u +%FT%TZ)" --argjson slot "$slot" \
        --arg alias "$alias" --arg type "session" \
        '{email:$email, saved_at:$ts, slot:$slot, alias:(if $alias=="" then null else $alias end), type:$type, enabled:true}' \
        > "$dir/meta.json"
    echo "$(_t msg_saved_cli "$name" "$email" "$slot")"
}

_has_cli_session() {
    security find-generic-password -s "$SVC_ACCESS" -a "$KC_ACCOUNT" -w >/dev/null 2>&1
}

_has_ide_session() {
    [[ -f "$IDE_DB" ]] || return 1
    local v; v=$(sqlite3 "$IDE_DB" "SELECT value FROM ItemTable WHERE key='cursorAuth/accessToken';" 2>/dev/null || true)
    [[ -n "$v" ]]
}

# captures whichever of CLI / Cursor.app IDE is currently logged in - either,
# both, or (if neither) errors. Most people only use one or the other, so
# this doesn't require both like the old always-capture-CLI version did.
cmd_add() {
    local name="" alias=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --alias) alias="$2"; shift 2 ;;
            *) name="$1"; shift ;;
        esac
    done
    [[ -n "$name" ]] || die "$(_t usage_add)"
    ensure_store

    local got_cli=0 got_ide=0
    if _has_cli_session; then
        capture_session "$name" "$alias"
        got_cli=1
    else
        echo "$(_t note_no_cli)"
    fi
    if _has_ide_session; then
        local ide_args=("$name")
        [[ -n "$alias" ]] && ide_args+=(--alias "$alias")
        cmd_ide_add "${ide_args[@]}"
        got_ide=1
    else
        echo "$(_t note_no_ide)"
    fi
    (( got_cli || got_ide )) || die "$(_t err_not_logged_in_anywhere)"
}

cmd_login() {
    local name="${1:?$(_t usage_login)}"
    ensure_store
    echo "$(_t msg_logging_out)"
    agent logout >/dev/null 2>&1 || true
    echo "$(_t msg_opening_browser)"
    agent login
    capture_session "$name"
}

cmd_add_token() {
    need_jq; ensure_store
    local token="${1:?$(_t usage_add_token)}"; shift || true
    local email="" alias=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --email) email="$2"; shift 2 ;;
            --alias) alias="$2"; shift 2 ;;
            *) shift ;;
        esac
    done
    [[ "$token" == "-" ]] && token=$(cat)
    [[ -n "$email" ]] || email="api-key-$(next_slot)@token.local"
    local dir="$STORE/$email" slot
    if [[ -d "$dir" ]]; then
        confirm "$(_t confirm_overwrite "$email" "$(jq -r '.email' "$dir/meta.json" 2>/dev/null || echo '?')")" || { echo "$(_t aborted)"; exit 1; }
        slot=$(jq -r '.slot' "$dir/meta.json")
        [[ -z "$alias" ]] && alias=$(jq -r '.alias // empty' "$dir/meta.json")
    else
        slot=$(next_slot)
    fi
    mkdir -p "$dir"; chmod 700 "$dir"
    printf '%s' "$token" > "$dir/api-key"; chmod 600 "$dir/api-key"
    jq -n --arg email "$email" --arg ts "$(date -u +%FT%TZ)" --argjson slot "$slot" \
        --arg alias "$alias" --arg type "api-key" \
        '{email:$email, saved_at:$ts, slot:$slot, alias:(if $alias=="" then null else $alias end), type:$type, enabled:true}' \
        > "$dir/meta.json"
    echo "$(_t msg_registered_api_key "$email" "$slot")"
}

_ide_running() { pgrep -x Cursor >/dev/null 2>&1; }

# decodes the auth0 subject ("sub") claim out of a Cursor JWT's payload, no
# verification (we already trust it - it's our own stored token).
_jwt_sub() {
    local payload; payload=$(cut -d. -f2 <<<"$1" | tr -- '-_' '+/')
    case $(( ${#payload} % 4 )) in
        2) payload="${payload}==" ;;
        3) payload="${payload}=" ;;
    esac
    base64 -d <<<"$payload" 2>/dev/null | jq -r '.sub // empty' 2>/dev/null
}

# jq program that turns [{key,value},...] rows into REPLACE-on-conflict INSERT
# statements (ItemTable.key is UNIQUE ON CONFLICT REPLACE, so a plain INSERT
# acts as an upsert). Built via a quoted heredoc so the SQL quote-escaping
# (' -> '') needs no bash-level escaping of its own.
IFS= read -r -d '' _IDE_ROWS_TO_SQL <<'JQEOF' || true
def esc: gsub("'"; "''");
.[] | "INSERT INTO ItemTable(key,value) VALUES('" + (.key|esc) + "', '" + ((.value|tostring)|esc) + "');"
JQEOF

cmd_ide_add() {
    need_jq; ensure_store
    local name="" alias=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --alias) alias="$2"; shift 2 ;;
            *) name="$1"; shift ;;
        esac
    done
    [[ -n "$name" ]] || die "$(_t usage_ide_add)"
    [[ -f "$IDE_DB" ]] || die "$(_t err_ide_db_not_found "$IDE_DB")"

    local rows; rows=$(sqlite3 -json "$IDE_DB" "SELECT key, value FROM ItemTable WHERE key LIKE 'cursorAuth/%';" 2>/dev/null || true)
    [[ -n "$rows" && "$rows" != "[]" ]] || die "$(_t err_no_ide_rows)"
    local ide_email; ide_email=$(jq -r '.[] | select(.key=="cursorAuth/cachedEmail") | .value' <<<"$rows")
    if [[ -z "$ide_email" ]]; then
        # right after a fresh IDE login, cachedEmail can lag behind the tokens
        # for a bit - fall back to matching the token's auth0 sub against a
        # saved CLI profile's own cached authId.
        local access_token sub
        access_token=$(jq -r '.[] | select(.key=="cursorAuth/accessToken") | .value' <<<"$rows")
        sub=$(_jwt_sub "$access_token")
        if [[ -n "$sub" ]]; then
            for cfg in "$STORE"/*/cli-config.json; do
                [[ -f "$cfg" ]] || continue
                if [[ "$(jq -r '.authInfo.authId // empty' "$cfg")" == "$sub" ]]; then
                    ide_email=$(jq -r '.authInfo.email' "$cfg")
                    break
                fi
            done
        fi
    fi
    [[ -n "$ide_email" ]] || die "$(_t err_no_cached_email)"

    local dir="$STORE/$name" slot
    if [[ -d "$dir" ]]; then
        slot=$(jq -r '.slot' "$dir/meta.json")
        [[ -z "$alias" ]] && alias=$(jq -r '.alias // empty' "$dir/meta.json")
    else
        slot=$(next_slot)
    fi
    mkdir -p "$dir"; chmod 700 "$dir"
    echo "$rows" > "$dir/ide-auth.json"; chmod 600 "$dir/ide-auth.json"

    if [[ -f "$dir/meta.json" ]]; then
        jq --arg e "$ide_email" '.ide_email = $e' "$dir/meta.json" > "$dir/meta.json.tmp" && mv "$dir/meta.json.tmp" "$dir/meta.json"
    else
        jq -n --arg email "$ide_email" --arg ts "$(date -u +%FT%TZ)" --argjson slot "$slot" \
            --arg alias "$alias" \
            '{email:$email, ide_email:$email, saved_at:$ts, slot:$slot, alias:(if $alias=="" then null else $alias end), type:"ide-only", enabled:true}' \
            > "$dir/meta.json"
    fi
    echo "$(_t msg_saved_ide "$name" "$ide_email" "$slot")"
}

_restore_ide_session() {
    local dir="$1"
    [[ -f "$dir/ide-auth.json" ]] || die "$(_t err_no_ide_captured "$(label "$dir")")"
    local sql; sql=$(jq -r "$_IDE_ROWS_TO_SQL" "$dir/ide-auth.json")
    # right after Cursor.app exits, a helper process can briefly still hold the
    # sqlite file lock - retry a couple times before giving up.
    local tries=0
    until sqlite3 "$IDE_DB" "$sql" 2>/dev/null; do
        (( tries++ >= 4 )) && die "$(_t err_ide_write_failed "$IDE_DB")"
        sleep 1
    done
}

# does the actual quit -> write -> relaunch dance for a profile's IDE session.
# caller must have already confirmed $dir/ide-auth.json exists.
_do_ide_switch() {
    local dir="$1"
    [[ -f "$IDE_DB" ]] || die "$(_t err_ide_db_not_found "$IDE_DB")"

    local was_running=0
    if _ide_running; then
        was_running=1
        confirm "$(_t confirm_ide_quit)" \
            || { echo "$(_t aborted)"; exit 1; }
        osascript -e 'quit app "Cursor"' >/dev/null 2>&1 || true
        local waited=0
        while _ide_running && (( waited < 15 )); do sleep 1; waited=$((waited + 1)); done
        _ide_running && die "$(_t err_ide_quit_timeout)"
    fi

    _restore_ide_session "$dir"
    echo "$(_t msg_swapped_ide "$(label "$dir")")"
    if [[ "$was_running" == "1" ]]; then
        open -a "Cursor"
        echo "$(_t msg_relaunched)"
    else
        echo "$(_t msg_ide_not_running)"
    fi
}

# switches the IDE session too, but only if this profile ever captured one
# (cursorswap ide-add) - silent no-op otherwise, so plain CLI-only users see
# no difference.
_maybe_switch_ide() {
    local dir="$1"
    [[ -f "$dir/ide-auth.json" ]] || return 0
    _do_ide_switch "$dir"
}

cmd_ide_switch() {
    need_jq
    local ref="${1:?$(_t usage_ide_switch)}"
    local dir; dir=$(require_profile "$ref")
    [[ -f "$dir/ide-auth.json" ]] || die "$(_t err_no_ide_captured_ref "$(label "$dir")" "$ref")"
    _do_ide_switch "$dir"
}

# switches a single resolved profile dir to "current" - CLI session (if it
# has one), IDE session (if it has one), whichever applies. Shared by both
# `switch <ref>` and plain rotating `switch`.
_switch_profile() {
    local dir="$1"
    local type; type=$(jq -r '.type' "$dir/meta.json")
    case "$type" in
        api-key) die "$(_t err_apikey_no_switch "$(label "$dir")" "$(basename "$dir")")" ;;
        ide-only)
            echo "$(_t msg_ide_only_switch "$(label "$dir")")"
            _maybe_switch_ide "$dir"
            echo "$(_t msg_usage_prefix "$(_usage_field "$(_effective_access_token "$dir")")")"
            return 0
            ;;
    esac

    local target_email now_email
    target_email=$(jq -r '.email' "$dir/meta.json")
    now_email=$(current_email)
    # trust the cache only if the Keychain token it describes still exists -
    # if something cleared the Keychain out from under a stale cache (agent
    # logout bypassing cursorswap, manual Keychain edits, etc.) a plain
    # cache-email match would wrongly skip the actual restore.
    if [[ "$now_email" == "$target_email" ]] && _has_cli_session; then
        echo "$(_t msg_already_on "$(label "$dir")" "$target_email")"
    else
        _restore_session "$dir"
        echo "$(_t msg_swapped_verifying "$(label "$dir")")"
        agent status
        _print_usage_line
    fi
    _maybe_switch_ide "$dir"
}

cmd_use() {
    need_jq
    local ref="${1:?$(_t usage_switch)}"
    local dir; dir=$(require_profile "$ref")
    _switch_profile "$dir"
}

_print_usage_line() {
    local tok; tok=$(security find-generic-password -s "$SVC_ACCESS" -a "$KC_ACCOUNT" -w 2>/dev/null) || tok=""
    echo "$(_t msg_usage_prefix "$(_usage_field "$tok")")"
}

_restore_session() {
    local dir="$1"
    security add-generic-password -U -s "$SVC_ACCESS"  -a "$KC_ACCOUNT" -w "$(cat "$dir/access-token")"  >/dev/null
    security add-generic-password -U -s "$SVC_REFRESH" -a "$KC_ACCOUNT" -w "$(cat "$dir/refresh-token")" >/dev/null
    jq -s '.[0] as $cur | .[1] as $saved | $cur
        | .authInfo = $saved.authInfo
        | .autoReviewAvailabilityCache = $saved.autoReviewAvailabilityCache
        | .serverConfigCache = $saved.serverConfigCache' \
        "$CONFIG" "$dir/cli-config.json" > "$CONFIG.tmp"
    mv "$CONFIG.tmp" "$CONFIG"
}

cmd_switch_next() {
    need_jq
    local dirs=() d now_email now_ide_email idx=-1 i=0
    now_email=$(current_email)
    now_ide_email=$(current_ide_email)
    while IFS= read -r d; do dirs+=("$d"); done < <(
        for m in "$STORE"/*/meta.json; do
            [[ -f "$m" ]] || continue
            jq -e 'select((.type=="session" or .type=="ide-only") and .enabled==true)' "$m" >/dev/null 2>&1 || continue
            jq -r '.slot' "$m"
        done | sort -n | while read -r s; do
            for m in "$STORE"/*/meta.json; do
                [[ "$(jq -r '.slot' "$m")" == "$s" ]] && dirname "$m"
            done
        done
    )
    [[ ${#dirs[@]} -gt 0 ]] || die "$(_t err_no_accounts)"
    # prefer matching by the current CLI session; fall back to the IDE one
    # (pure IDE-only setups have no CLI session to match at all).
    if _has_cli_session; then
        for i in "${!dirs[@]}"; do
            [[ "$(jq -r '.type' "${dirs[$i]}/meta.json")" == "session" && \
               "$(jq -r '.email' "${dirs[$i]}/meta.json")" == "$now_email" ]] && idx=$i && break
        done
    fi
    if [[ "$idx" == "-1" && -n "$now_ide_email" ]]; then
        for i in "${!dirs[@]}"; do
            [[ "$(jq -r '.ide_email // empty' "${dirs[$i]}/meta.json")" == "$now_ide_email" ]] && idx=$i && break
        done
    fi
    local next=$(( (idx + 1) % ${#dirs[@]} ))
    _switch_profile "${dirs[$next]}"
}

cmd_list() {
    need_jq; ensure_store
    local now_email now_ide_email
    now_email=$(current_email)
    now_ide_email=$(current_ide_email)
    local any=0
    echo "$(_t hdr_accounts)"
    for m in "$STORE"/*/meta.json; do
        [[ -f "$m" ]] || continue
        any=1
        local dir slot email type enabled alias saved_at tag ide_email
        dir=$(dirname "$m")
        slot=$(jq -r '.slot' "$m"); email=$(jq -r '.email' "$m"); type=$(jq -r '.type' "$m")
        enabled=$(jq -r '.enabled' "$m"); alias=$(jq -r '.alias // empty' "$m"); saved_at=$(jq -r '.saved_at' "$m")
        ide_email=$(jq -r '.ide_email // empty' "$m")
        tag=""
        if [[ "$type" == "session" && "$email" == "$now_email" ]]; then tag=" $(_bold_accent "$(_t tag_cli_active)")"; fi
        if [[ -n "$ide_email" && -n "$now_ide_email" && "$ide_email" == "$now_ide_email" ]]; then
            tag="$tag $(_bold_accent "$(_t tag_ide_active)")"
        fi
        [[ "$enabled" == "false" ]] && tag="$tag $(_muted "$(_t tag_disabled)")"
        [[ "$type" == "api-key" ]] && tag="$tag $(_muted "$(_t tag_apikey)")"
        [[ "$type" == "ide-only" ]] && tag="$tag $(_muted "$(_t tag_ideonly)")"
        # pad plain text to fixed width FIRST, color after - ANSI codes count
        # toward printf's width and would misalign the columns otherwise.
        local slot_str email_str
        printf -v slot_str '%-3s' "$slot:"
        printf -v email_str '%-28s' "$email"
        local alias_str=""
        [[ -n "$alias" ]] && alias_str="$(_muted "\"$alias\" ")"
        printf '  %s %s %s%s\n' "$(_bold "$slot_str")" "$(_accent "$email_str")" "$alias_str" "$tag"
        printf '      %s %s\n' "$(_muted "$(_t lbl_saved)")" "$(_muted "$saved_at")"
        if [[ "$type" == "session" || "$type" == "ide-only" ]]; then
            printf '      %s %s\n' "$(_muted "$(_t lbl_usage)")" \
                "$(_usage_field "$(_effective_access_token "$dir")")"
        fi
        [[ -n "$ide_email" && "$type" != "ide-only" ]] && printf '      %s   %s\n' "$(_muted "$(_t lbl_ide)")" "$(_muted "$ide_email")"
    done
    [[ "$any" == "1" ]] || echo "  $(_t msg_none_saved)"
    echo
    _muted "$(_t note_usage_line1)"; echo
    _muted "$(_t note_usage_line2)"; echo
}

cmd_status() { agent status; agent about; }

cmd_usage() {
    need_jq
    local ref="${1:-}" token label_str
    if [[ -n "$ref" ]]; then
        local dir; dir=$(require_profile "$ref")
        local type; type=$(jq -r '.type' "$dir/meta.json")
        [[ "$type" == "session" || "$type" == "ide-only" ]] \
            || die "$(_t err_no_session_or_ide "$(label "$dir")" "$type")"
        token=$(_effective_access_token "$dir")
        [[ -n "$token" ]] || die "$(_t err_no_token "$(label "$dir")")"
        label_str=$(label "$dir")
    else
        token=$(security find-generic-password -s "$SVC_ACCESS" -a "$KC_ACCOUNT" -w 2>/dev/null)
        if [[ -n "$token" ]]; then
            label_str="$(_accent "$(current_email)") $(_bold_accent "$(_t tag_cli_active)")"
        else
            token=$(sqlite3 "$IDE_DB" "SELECT value FROM ItemTable WHERE key='cursorAuth/accessToken';" 2>/dev/null || true)
            [[ -n "$token" ]] || die "$(_t err_no_active_session)"
            label_str="$(_accent "$(current_ide_email)") $(_bold_accent "$(_t tag_ide_active)")"
        fi
    fi
    local u rc=0
    u=$(usage_summary "$token") || rc=$?
    (( rc == 0 )) || die "$(_t err_usage_failed "$u")"
    echo "$label_str: $u"
}

cmd_remove() {
    local ref="${1:?$(_t usage_remove)}"
    local dir; dir=$(require_profile "$ref")
    local lbl; lbl=$(label "$dir")
    confirm "$(_t confirm_delete "$lbl")" || { echo "$(_t aborted)"; exit 1; }
    rm -rf "${dir:?}"
    echo "$(_t msg_removed "$lbl")"
}

cmd_enable_disable() {
    need_jq
    local state="$1" ref="${2:?$(_t usage_enable_disable "$1")}"
    local dir; dir=$(require_profile "$ref")
    jq --argjson v "$state" '.enabled = $v' "$dir/meta.json" > "$dir/meta.json.tmp" && mv "$dir/meta.json.tmp" "$dir/meta.json"
    if [[ "$state" == "true" ]]; then echo "$(_t msg_enabled "$(label "$dir")")"; else echo "$(_t msg_disabled "$(label "$dir")")"; fi
}

cmd_alias() {
    need_jq
    if [[ $# -eq 0 ]]; then
        for m in "$STORE"/*/meta.json; do
            [[ -f "$m" ]] || continue
            local a; a=$(jq -r '.alias // empty' "$m")
            [[ -n "$a" ]] && printf '  %-15s -> %s\n' "$a" "$(jq -r '.email' "$m")"
        done
        return
    fi
    local ref="$1"; local dir; dir=$(require_profile "$ref")
    if [[ "${2:-}" == "--unset" ]]; then
        jq '.alias = null' "$dir/meta.json" > "$dir/meta.json.tmp" && mv "$dir/meta.json.tmp" "$dir/meta.json"
        echo "$(_t msg_unset_alias "$(basename "$dir")")"
    else
        local newalias="${2:?$(_t usage_alias)}"
        jq --arg a "$newalias" '.alias = $a' "$dir/meta.json" > "$dir/meta.json.tmp" && mv "$dir/meta.json.tmp" "$dir/meta.json"
        echo "$(_t msg_alias_set "$newalias" "$(basename "$dir")")"
    fi
}

cmd_map() {
    need_jq; ensure_store
    if [[ $# -eq 0 ]]; then
        jq -r 'to_entries[] | "  \(.value)  ->  \(.key)"' "$MAP_FILE"
        return
    fi
    local ref="$1" path="${2:-$PWD}"
    local dir; dir=$(require_profile "$ref")
    path=$(cd "$path" 2>/dev/null && pwd) || die "$(_t err_path_not_dir "${2:-$PWD}")"
    jq --arg p "$path" --arg n "$(basename "$dir")" '.[$p] = $n' "$MAP_FILE" > "$MAP_FILE.tmp" && mv "$MAP_FILE.tmp" "$MAP_FILE"
    echo "$(_t msg_mapped "$path" "$(label "$dir")")"
}

cmd_unmap() {
    need_jq; ensure_store
    local path="${1:-$PWD}"
    path=$(cd "$path" 2>/dev/null && pwd) || die "$(_t err_path_not_dir "${1:-$PWD}")"
    jq --arg p "$path" 'del(.[$p])' "$MAP_FILE" > "$MAP_FILE.tmp" && mv "$MAP_FILE.tmp" "$MAP_FILE"
    echo "$(_t msg_unmapped "$path")"
}

mapped_profile_for_cwd() {
    need_jq; ensure_store
    local dir="$PWD"
    while [[ "$dir" != "/" ]]; do
        local name; name=$(jq -r --arg p "$dir" '.[$p] // empty' "$MAP_FILE")
        [[ -n "$name" ]] && { echo "$name"; return; }
        dir=$(dirname "$dir")
    done
}

cmd_run() {
    local ref="${1:-}"
    if [[ -n "$ref" && "$ref" != "--" ]]; then shift; else ref=$(mapped_profile_for_cwd) || true; fi
    [[ "${1:-}" == "--" ]] && shift
    [[ -n "$ref" ]] || die "$(_t err_no_account_no_mapping "$PWD")"
    local dir; dir=$(require_profile "$ref")
    local type; type=$(jq -r '.type' "$dir/meta.json")

    if [[ "$type" == "api-key" ]]; then
        exec agent --api-key "$(cat "$dir/api-key")" "$@"
    fi
    [[ "$type" == "session" ]] || die "$(_t err_ideonly_no_run "$(label "$dir")")"

    # session type: no real per-terminal isolation exists (Keychain is
    # OS-user-global; CURSOR_DATA_DIR was tested and does NOT scope auth).
    # Best effort: swap in, run, swap back to whatever was active before.
    echo "$(_t warn_run_line1 "$(label "$dir")")" >&2
    echo "$(_t warn_run_line2)" >&2
    echo "$(_t warn_run_line3)" >&2
    confirm "$(_t confirm_continue)" || { echo "$(_t aborted)"; exit 1; }

    local prev_email prev_dir
    prev_email=$(current_email)
    prev_dir=""
    for m in "$STORE"/*/meta.json; do
        [[ -f "$m" ]] || continue
        if jq -e --arg e "$prev_email" 'select(.type=="session" and .email==$e)' "$m" >/dev/null 2>&1; then
            prev_dir=$(dirname "$m"); break
        fi
    done

    _restore_session "$dir"
    local status=0
    agent "$@" || status=$?

    if [[ -n "$prev_dir" ]]; then
        _restore_session "$prev_dir"
    else
        echo "$(_t note_prev_not_saved "$prev_email")" >&2
    fi
    exit $status
}

cmd_export() {
    local path="${1:?$(_t usage_export)}"
    ensure_store
    tar czf "$path" -C "$STORE" .
    chmod 600 "$path"
    echo "$(_t msg_exported "$(find "$STORE" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l | tr -d '[:space:]')" "$path")"
    echo "$(_t warn_export_plaintext)"
}

cmd_import() {
    local path="${1:?$(_t usage_import)}"
    ensure_store
    [[ -f "$path" ]] || die "$(_t err_path_not_found "$path")"
    local tmp; tmp=$(mktemp -d)
    tar xzf "$path" -C "$tmp"
    local d name
    for d in "$tmp"/*/; do
        [[ -f "$d/meta.json" ]] || continue
        name=$(basename "$d")
        if [[ -d "$STORE/$name" && "${FORCE:-0}" != "1" ]]; then
            echo "$(_t msg_skip_import "$name")"
            continue
        fi
        rm -rf "${STORE:?}/${name:?}"
        cp -R "$d" "$STORE/$name"
        chmod 700 "$STORE/$name"
        chmod 600 "$STORE/$name"/*token "$STORE/$name"/api-key 2>/dev/null || true
        echo "$(_t msg_imported "$name")"
    done
    rm -rf "${tmp:?}"
}

cmd_purge() {
    confirm "$(_t confirm_purge "$STORE")" || { echo "$(_t aborted)"; exit 1; }
    rm -rf "${STORE:?}"
    echo "$(_t msg_purged "$STORE")"
}

cmd_version() { echo "cursorswap $VERSION"; }

cmd_lang() {
    echo "$(_t msg_lang_current "$CURSOR_SWAP_LANG")"
    echo "$(_t msg_lang_howto)"
}
MSG_EN[msg_lang_current]="Current language: {1}"
MSG_VI[msg_lang_current]="Ngôn ngữ hiện tại: {1}"
MSG_EN[msg_lang_howto]="Change with: cursorswap --lang <en|vi> <command>..., or export CURSOR_SWAP_LANG=vi in your shell rc to always use it."
MSG_VI[msg_lang_howto]="Đổi bằng: cursorswap --lang <en|vi> <lệnh>..., hoặc export CURSOR_SWAP_LANG=vi trong shell rc để dùng luôn."

# repeats `list` every N seconds (default 30, floor 5 - each refresh hits the
# undocumented usage-% endpoint once per session/ide-only profile, and we
# have no rate-limit info for it, so this deliberately can't be set to
# hammer it every second).
cmd_watch() {
    local interval="${1:-30}"
    [[ "$interval" =~ ^[0-9]+$ ]] || interval=30
    (( interval < 5 )) && interval=5
    trap 'echo; exit 0' INT
    while true; do
        clear 2>/dev/null || true
        echo "$(_muted "$(_t msg_watch_header "$interval")")"
        echo
        cmd_list
        sleep "$interval"
    done
}
MSG_EN[msg_watch_header]="cursorswap watch - refreshing every {1}s, Ctrl-C to stop"
MSG_VI[msg_watch_header]="cursorswap watch - làm mới mỗi {1}s, Ctrl-C để dừng"

# closes gaps in slot numbers (e.g. after 'remove'), keeping relative order.
# Aliases/mappings reference profiles by directory name, not slot, so this
# doesn't touch either - only meta.json's own .slot field.
cmd_renumber() {
    need_jq; ensure_store
    local pairs=() m slot dir
    for m in "$STORE"/*/meta.json; do
        [[ -f "$m" ]] || continue
        slot=$(jq -r '.slot' "$m")
        pairs+=("$(printf '%s\t%s' "$slot" "$(dirname "$m")")")
    done
    [[ ${#pairs[@]} -gt 0 ]] || { echo "  $(_t msg_none_saved)"; return; }
    local sorted; sorted=$(printf '%s\n' "${pairs[@]}" | sort -n -t $'\t' -k1,1)
    local i=1
    while IFS=$'\t' read -r _ dir; do
        jq --argjson s "$i" '.slot = $s' "$dir/meta.json" > "$dir/meta.json.tmp" && mv "$dir/meta.json.tmp" "$dir/meta.json"
        i=$((i + 1))
    done <<<"$sorted"
    echo "$(_t msg_renumbered "$((i - 1))")"
}
MSG_EN[msg_renumbered]="Renumbered {1} account(s) to contiguous slots 1..{1}."
MSG_VI[msg_renumbered]="Đã đánh lại số slot cho {1} account, liền mạch từ 1..{1}."

cmd_update() {
    local self="$0"
    case "$self" in
        /*) ;;
        *) self="$(command -v -- "$self" 2>/dev/null || echo "$PWD/$self")" ;;
    esac
    [[ -w "$self" ]] || die "$(_t err_not_writable "$self")"

    local tmp; tmp=$(mktemp)
    curl -fsSL "$RAW_BASE/cursorswap" -o "$tmp" || { rm -f "$tmp"; die "$(_t err_download_failed)"; }
    chmod +x "$tmp"

    if cmp -s "$tmp" "$self"; then
        rm -f "$tmp"
        echo "$(_t msg_already_uptodate "$VERSION")"
        return
    fi
    local new_version; new_version=$(grep -m1 '^VERSION=' "$tmp" | cut -d'"' -f2 || true)
    mv "$tmp" "$self"
    echo "$(_t msg_updated "$VERSION" "${new_version:-unknown}")"
}

